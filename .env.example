# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HASHSCAN_BASE_URL=https://hashscan.io/testnet

# Hedera operator account for server-side Agent Kit execution
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=0.0.xxxxx
HEDERA_OPERATOR_PRIVATE_KEY=302e...

# HCS topic and HTS token used by the paid proof action
HEDERA_PROOF_TOKEN_ID=0.0.xxxxx
HEDERA_HCS_TOPIC_ID=0.0.xxxxx

# x402
X402_PAYMENT_ASSET=USDC
X402_PRICE_AMOUNT=0.25
X402_PAY_TO_ACCOUNT_ID=0.0.xxxxx
X402_USDC_TOKEN_ID=0.0.429274

# Proof state / retry recovery
# Use Upstash Redis REST for hosted/serverless demos. If unset, local file storage is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PROOFMINT_STATE_KEY=proofmint:proof-state
PROOFMINT_STATE_DIR=.proofmint-state

# API abuse controls
MINT_PROOF_RATE_LIMIT_MAX=10
MINT_PROOF_RATE_LIMIT_WINDOW_MS=60000

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# Optional AI provider if a natural-language agent summary is implemented
OPENAI_API_KEY=
